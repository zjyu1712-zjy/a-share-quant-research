# Optional news module only. Never commit real credentials.
DEEPSEEK_API_KEY=
# Set a model name currently offered by your provider before using news analysis.
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# These settings affect legacy v1 commands. v2 uses build_v2_config(), not .env.
BASELINE_MODE=true
BACKTEST_MODE=price_only
SENTIMENT_WEIGHT=0
ALLOW_PRICE_SENTIMENT_PROXY=false
STOP_LOSS_PCT=0
TRAILING_STOP_PCT=0
TIME_STOP_MONTHS=0
